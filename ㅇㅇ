"""앱이 부르는 가격 API (Render Web Service).

GET /prices?size=4&market=380401&date=2027-06-25
  - size: 상자 kg (2, 2.5, 3, 4, 4.5, 5, 10). 비우면 크기 구분 없이 kg당 가격만
  - market: 도매시장 코드. 비우면 전국
  - date: 기준일 (기본 오늘, 한국 시간). 시험용
  - 헤더: Authorization: Bearer <Firebase ID 토큰>  (REQUIRE_AUTH=true일 때)
GET /markets   시장 코드 목록
GET /health    상태 확인
"""
from datetime import date, datetime, timedelta, timezone

from fastapi import Depends, FastAPI, Header, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware

from peach_price import config
from peach_price.prices import build_view

KST = timezone(timedelta(hours=9))
SIZES = {"2", "2.5", "3", "4", "4.5", "5", "10"}

app = FastAPI(title="미홍 복숭아 가격 API")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["GET"],
                   allow_headers=["Authorization"])

_store = None


def get_store():
    global _store
    if _store is None:
        from peach_price.store import FirestoreStore
        _store = FirestoreStore()
    return _store


def verify_user(authorization: str | None = Header(default=None)):
    if not config.REQUIRE_AUTH:
        return None
    if not authorization or not authorization.startswith("Bearer "):
        raise HTTPException(401, "로그인이 필요합니다")
    from firebase_admin import auth
    from peach_price.store import db
    db()  # Firebase 초기화
    try:
        return auth.verify_id_token(authorization.split(" ", 1)[1])
    except Exception:
        raise HTTPException(401, "로그인 정보가 올바르지 않습니다")


@app.get("/health")
def health():
    return {"ok": True}


@app.get("/markets")
def markets():
    return [{"code": k, "name": v} for k, v in config.MARKETS.items()]


@app.get("/prices")
def prices(size: str | None = Query("4"), market: str | None = None,
           date_: str | None = Query(None, alias="date"),
           _user=Depends(verify_user), store=Depends(get_store)):
    if size and size not in SIZES:
        raise HTTPException(400, f"size는 {sorted(SIZES, key=float)} 중 하나")
    if market and market not in config.MARKETS:
        raise HTTPException(400, "알 수 없는 시장 코드")
    try:
        today = date.fromisoformat(date_) if date_ else datetime.now(KST).date()
    except ValueError:
        raise HTTPException(400, "date는 YYYY-MM-DD 형식")
    return build_view(store, today, size or None, market)

"""가격 수집 명령.

  python collect.py probe                 # 응답 형식과 코드 확인 (서울가락, 2026-06-25)
  python collect.py backfill 2024 2026    # 지난 시즌 자료 한꺼번에 받기 (중간에 끊겨도 이어서 받음)
  python collect.py day 2026-06-25        # 하루치만 다시 받기
  python collect.py daily                 # 오늘 자료 받기 (Render Cron Job용, 비수기엔 아무것도 안 함)
"""
import sys
from collections import Counter
from datetime import date, datetime, timedelta, timezone

from peach_price import config
from peach_price.kat_client import fetch_market_day
from peach_price.normalize import aggregate_day, is_target, to_record

KST = timezone(timedelta(hours=9))


def probe(ymd: str = "2026-06-25", market: str = "110001"):
    print(f"[1] 품목 조건 포함 조회: {config.MARKETS[market]} {ymd}, "
          f"LCLSF={config.LCLSF_CD!r} MCLSF={config.MCLSF_CD!r}")
    rows = fetch_market_day(market, ymd, with_item_filter=True)
    print(f"    {len(rows)}건")
    if not rows:
        print("[2] 0건이라 품목 조건 없이 다시 조회 (코드 형식 확인용)")
        rows = fetch_market_day(market, ymd, with_item_filter=False)
        print(f"    {len(rows)}건")
    peach = [r for r in rows if "복숭아" in (r.get("gds_mclsf_nm") or "")]
    if not peach:
        print("복숭아 행이 없음. 날짜나 시장을 바꿔 다시 해 보세요.")
        return
    codes = Counter((r.get("gds_lclsf_cd"), r.get("gds_mclsf_cd"), r.get("gds_sclsf_cd"),
                     r.get("gds_sclsf_nm")) for r in peach)
    print("\n복숭아 코드 (대분류, 중분류, 소분류, 품종명): 건수")
    for k, n in codes.most_common(15):
        print(f"  {k}: {n}")
    print("\n첫 행 원본:")
    for k, v in peach[0].items():
        print(f"  {k}: {v}")
    target = [r for r in peach if is_target(r)]
    ok = [to_record(r) for r in target]
    print(f"\n대상(일반·백도·기타) {len(target)}건 중 계산 가능 {sum(1 for x in ok if x)}건")
    print("단위 예시:", Counter((r.get('unit_qty'), r.get('unit_nm'), r.get('pkg_nm')) for r in target).most_common(5))
    print("\n→ 위 중분류 코드가 0604가 아니면 KAT_MCLSF_CD 환경변수를 그 값으로 바꾸세요.")


def collect_day(store, ymd: str, skip_done: bool = False) -> dict | None:
    if skip_done:
        existing = store.get_day(ymd)
        if existing and len(existing.get("markets_done", [])) == len(config.MARKETS):
            print(f"{ymd} 이미 받음, 건너뜀")
            return existing
    rows, done = [], []
    for code in config.MARKETS:
        rows.extend(fetch_market_day(code, ymd))
        done.append(code)
    agg = aggregate_day(rows)
    if agg["all"] is None:
        print(f"{ymd} 거래 없음 (휴장일 등)")
    else:
        print(f"{ymd} 전국 kg당 {agg['all']['won_per_kg']:,}원, {agg['all']['total_kg']:,}kg")
    store.save_day(ymd, agg, done)
    return agg


def season_dates(year: int):
    d = date.fromisoformat(f"{year}-{config.SEASON_START}")
    end = date.fromisoformat(f"{year}-{config.SEASON_END}")
    while d <= end:
        yield d.isoformat()
        d += timedelta(days=1)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "daily"
    if cmd == "probe":
        probe(*argv[2:4])
        return
    from peach_price.store import FirestoreStore
    store = FirestoreStore()
    if cmd == "backfill":
        y1, y2 = int(argv[2]), int(argv[3])
        for y in range(y1, y2 + 1):
            for ymd in season_dates(y):
                collect_day(store, ymd, skip_done=True)
    elif cmd == "day":
        collect_day(store, argv[2])
    elif cmd == "daily":
        today = datetime.now(KST).date()
        if not (config.SEASON_START <= today.strftime("%m-%d") <= config.SEASON_END):
            print(f"{today} 출하기 아님, 수집 안 함")
            return
        # 늦게 올라오는 정산분이 있어 어제 것도 다시 받음
        for d in (today - timedelta(days=1), today):
            collect_day(store, d.isoformat())
    else:
        print(__doc__)


if __name__ == "__main__":
    main(sys.argv)

# 미홍 복숭아 가격 API

aT 「전국 공영도매시장 정산정보」 API에서 복숭아 경매 정산 자료를 받아 Firebase Firestore에 일자별로 저장하고, 앱에 금일 시세·작년 대비·지난 3년 가격·추세 그래프 자료를 제공함.

- 미홍은 표준코드에 품종이 없어 **같은 시기 조생 백도계 복숭아 시세**(품종명 복숭아(일반)·백도·기타)로 대신함.
- 기간은 매년 6월 10일~7월 10일, 범위는 전국 32개 공영도매시장.
- 가격은 상자 크기별 거래량 가중 평균(kg당)으로 계산하고 상자 가격으로 환산함.

## 구성

| 파일 | 역할 |
|---|---|
| `collect.py` | 수집 명령 (probe / backfill / day / daily) |
| `app.py` | 앱이 부르는 가격 API (FastAPI) |
| `peach_price/kat_client.py` | 정산정보 API 호출, 페이지 처리, 재시도 |
| `peach_price/normalize.py` | 대상 품종 거르기, kg 환산, 하루 집계 |
| `peach_price/prices.py` | 금일·작년 대비·지난 3년·그래프 계산 |
| `peach_price/store.py` | Firestore 저장·조회 |
| `render.yaml` | Render 웹 서비스 + 매일 수집 크론 잡 |

## 1. 로컬에서 처음 확인하기

```bash
python -m venv .venv && source .venv/bin/activate
pip install -r requirements.txt
cp .env.example .env      # 인증키와 Firebase 키 경로 입력 (코드가 .env를 자동으로 읽음)
python collect.py probe   # 서울가락 2026-06-25 자료로 응답 형식 확인
```

`probe` 출력에서 확인할 것:

1. **건수가 0이 아닌지.** 0이면 인증키가 아직 등록 전일 수 있음(발급 후 1~2시간).
2. **복숭아 코드 형식.** 중분류 코드가 `04`가 아니면 `.env`의 `KAT_MCLSF_CD`를 그 값으로 바꿈. 대분류도 같음.
3. **단위 예시.** `('4', 'kg', '상자')`처럼 kg 단위인지 확인.
4. **API 제공 기간.** `python collect.py probe 2024-06-25`로 2024년 날짜도 나오는지 확인.

결과가 이상하면 출력 전체를 Claude에게 보여 주면 됨. **인증키는 보여 주지 말 것.**

## 2. 지난 시즌 자료 받기 (한 번만)

```bash
python collect.py backfill 2024 2026
```

- 날짜 하나에 시장 32곳을 따로 부르므로 3년치(93일)면 약 3,000번 호출함. 개발계정 하루 한도(10,000건) 안임.
- 중간에 끊기면 같은 명령을 다시 실행하면 됨. 다 받은 날짜는 건너뜀.

## 3. Firebase 준비

1. Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → **새 비공개 키 생성** → JSON 파일 받기.
2. Firestore 규칙에서 `peach_daily` 컬렉션은 앱이 직접 쓰지 못하게 막음. 서버(서비스 계정)는 규칙과 무관하게 씀.

```
match /peach_daily/{doc} {
  allow read, write: if false;
}
```

## 4. Render 배포

1. 이 폴더를 GitHub 저장소에 올림(`.env`, 서비스 계정 JSON은 `.gitignore`로 제외됨).
2. Render → New → **Blueprint** → 저장소 선택 → `render.yaml`로 서비스 2개 생성.
3. 환경변수 입력
   - `peach-price-api`: `FIREBASE_SERVICE_ACCOUNT` (서비스 계정 JSON 내용 전체)
   - `peach-price-collect`: `KAT_SERVICE_KEY`, `FIREBASE_SERVICE_ACCOUNT`
   - probe에서 코드 형식을 바꿨다면 `KAT_LCLSF_CD`, `KAT_MCLSF_CD`도 두 곳에 추가.
4. 크론 잡은 매일 한국 시간 16:10에 돌고, 출하기(6/10~7/10)가 아니면 바로 끝남. 전날 것도 함께 다시 받아 늦게 올라온 정산분을 채움.

Render 크론 잡은 무료 플랜이 없어 소액 요금이 붙음. 웹 서비스 무료 플랜은 15분 동안 요청이 없으면 잠들어서 첫 요청이 30초 정도 느릴 수 있음.

## 5. 앱에서 부르기

```
GET https://<render 주소>/prices?size=4&market=380401
Authorization: Bearer <Firebase 로그인 ID 토큰>
```

- `size`: 상자 kg (2, 2.5, 3, 4, 4.5, 5, 10). 빈 값이면 kg당 가격만.
- `market`: 도매시장 코드(`/markets`로 목록 확인). 빈 값이면 전국.
- `date`: 시험용 기준일. 예: 비수기인 지금 `date=2026-06-25`로 시즌 화면 시험.

응답 예시 (요약):

```json
{
  "basis": "같은 시기 조생 백도계 복숭아 시세 (품종: 복숭아(일반)·백도·기타)",
  "in_season": true,
  "reference_date": "2027-06-25",
  "market_name": "전국",
  "current": {"date": "2027-06-25", "won_per_kg": 3750, "box_avg": 15000, "box_min": 8000, "box_max": 20000},
  "vs_last_year_pct": -6.2,
  "past_years": [
    {"label": "작년", "year": 2026, "won_per_kg": 4000, "box_avg": 16000},
    {"label": "재작년", "year": 2025, "won_per_kg": 3000, "box_avg": 12000},
    {"label": "재재작년", "year": 2024, "won_per_kg": 3500, "box_avg": 14000}
  ],
  "avg_3y_won_per_kg": 3500,
  "series": {"2027": [{"md": "06-25", "won_per_kg": 3750}], "2026": [...]}
}
```

- 금일 자료가 없으면(휴장일 등) 최대 3일 전 경매일 값을 쓰고 `current.date`에 그 날짜가 나옴.
- 비수기에는 `in_season: false`이고 직전 시즌 마지막 날(7/10) 기준 값이 나옴.
- 시장을 고르면 최저·최고가는 빠지고 kg당·상자 평균만 나옴.

## 6. 테스트

```bash
pip install pytest && python -m pytest -q tests
```

## 확인이 필요한 부분

- **단위총물량의 뜻:** 확인 완료. 총 kg임 (예: 3kg 상자 3개 → 9).
- **코드 형식:** 확인 완료. 대분류 `06`, 중분류 `04` (2026-11-14 probe).
- **API 과거 자료 기간:** 2024년 자료가 API로 나오는 것 확인함.

# Render Blueprint: 가격 API(웹 서비스) + 매일 수집(크론 잡)
# 비밀값(sync: false)은 Render 대시보드에서 직접 입력함.
services:
  - type: web
    name: peach-price-api
    runtime: python
    region: singapore
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn app:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /health
    envVars:
      - key: PYTHON_VERSION
        value: 3.12.7
      - key: FIREBASE_SERVICE_ACCOUNT
        sync: false
      - key: REQUIRE_AUTH
        value: "true"

  - type: cron
    name: peach-price-collect
    runtime: python
    region: singapore
    # 매일 한국 시간 16:10 (UTC 07:10). 비수기에는 스크립트가 바로 끝남.
    schedule: "10 7 * * *"
    buildCommand: pip install -r requirements.txt
    startCommand: python collect.py daily
    envVars:
      - key: PYTHON_VERSION
        value: 3.12.7
      - key: KAT_SERVICE_KEY
        sync: false
      - key: FIREBASE_SERVICE_ACCOUNT
        sync: false

