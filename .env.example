# 복사해서 .env로 저장하고 값을 채움. .env는 절대 git에 올리지 않음.

# 공공데이터포털 일반 인증키 (Decoding 키)
KAT_SERVICE_KEY=

# Firebase 서비스 계정 키 파일 경로 (로컬 실행용)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Render에서는 위 파일 대신 JSON 내용 전체를 이 변수에 한 줄로 넣음
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# probe 결과 코드 형식이 다르면 바꿈
KAT_LCLSF_CD=06
KAT_MCLSF_CD=04

# 로컬 시험 중 로그인 검사를 끄려면 false
REQUIRE_AUTH=true
